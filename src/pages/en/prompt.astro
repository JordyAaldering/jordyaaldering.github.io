---
import BaseLayout from "../../layouts/BaseLayout.astro";

import promptsText from "../../assets/prompt/prompts.txt?raw";

const prompts = promptsText
    .split("\n")
    .map(s => s.trim())
    .filter(Boolean);

const START_DATE = new Date("2026-08-18T00:00:00");

const today = new Date();
today.setHours(0, 0, 0, 0);

const daysSinceStart = Math.floor(
    (today.getTime() - START_DATE.getTime()) /
    (1000 * 60 * 60 * 24)
);

const prompt = prompts[daysSinceStart % prompts.length];

---

<BaseLayout title="Daily Writing Prompt">

    <h1>Daily Writing Prompt</h1>

    <p>
    <strong>{today.toLocaleDateString()}</strong>
    </p>

    <blockquote>
    {prompt}
    </blockquote>
</BaseLayout>
